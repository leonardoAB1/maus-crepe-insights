# Exported Maus data stays local (company data, repo is public)
data/
# Only these documentation pages are exempt from the data-directory rule.
!/documentation/data/
/documentation/data/*
!/documentation/data/data.md
!/documentation/data/mcap.md
!/documentation/data/pipeline.md
*.mcap
*.parquet
*.mp4

# Secrets / tokens
.env
.maus-export/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Git worktrees (one per branch, see AGENTS.md)
worktrees/

# macOS metadata
.DS_Store

# Personal agent notes (any tool)
*.local.md

# Worktree folders created by agent tools (outside the convention)
.claude/worktrees/

# Pixi environments and tool caches
.pixi/
.ruff_cache/

# Jupyter checkpoints (can hold notebook outputs)
.ipynb_checkpoints/
