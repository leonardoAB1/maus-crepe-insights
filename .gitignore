# Exported Maus data stays local (company data, repo is public)
data/
# Markdown pages in documentation/data/ are guides, not exported data.
!/documentation/data/
/documentation/data/*
!/documentation/data/*.md
*.mcap
*.parquet
*.mp4

# Private ML inputs and intermediates, including accidental alternate paths
training_data/
training-data/
datasets/
checkpoints/
*.pt
*.pth
*.ckpt

# Secrets / tokens
.env
.maus-export/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Git worktrees (one per branch, see AGENTS.md)
worktrees/

# macOS metadata
.DS_Store

# Personal agent notes (any tool)
*.local.md

# Worktree folders created by agent tools (outside the convention)
.claude/worktrees/

# Pixi environments and tool caches
.pixi/
.ruff_cache/

# Jupyter checkpoints (can hold notebook outputs)
.ipynb_checkpoints/
